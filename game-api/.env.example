# ── Runtime ──────────────────────────────────────────────────────────────────
# local | dev | stg | prd  (default: local)
ENV=local

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
# Allowed CORS origin. Set to frontend URL in non-local envs.
CORS_ORIGIN=http://localhost:5173

# ── Auth0 (required in non-local) ─────────────────────────────────────────────
AUTH0_ISSUER=

# ── Skylark Coupon API (required in non-local) ────────────────────────────────
COUPON_API_URL=
X_SKYLARK_TOKEN=

# Database
DATABASE_URL=postgresql://game_user:game_password@localhost:5432/game_db
