# ── Runtime ──────────────────────────────────────────────────────────────────
# local | dev | stg | prd  (default: local)
ENV=local

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
# Allowed CORS origin. Set to frontend URL in non-local envs.
CORS_ORIGIN=http://localhost:5173

# ── Auth0 (required in non-local) ─────────────────────────────────────────────
AUTH0_ISSUER=

# ── Skylark Coupon API (required in non-local) ────────────────────────────────
COUPON_API_URL=
X_SKYLARK_TOKEN=

# ── Game Config (all optional — defaults shown) ───────────────────────────────
WIN_PROBABILITY=0.5
COUPON_ID=1000000001
COUPON_TITLE=すかいらーくグループ全店共通クーポン
COUPON_DISCOUNT=500円OFF
# COUPON_START_DATE=
# COUPON_END_DATE=
