# ── Runtime ──────────────────────────────────────────────────────────────────
# Set to false to call real game-api endpoints
VITE_DEMO_MODE=false

# ── API ───────────────────────────────────────────────────────────────────────
# game-api base URL (local dev: http://localhost:3001)
VITE_API_BASE_URL=http://localhost:3001

# ── AppLink ───────────────────────────────────────────────────────────────────
# Base URL for native app deep links (coupon redirect after win)
VITE_SKYLARK_BASE_URL=https://www.skylark.co.jp
